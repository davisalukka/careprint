{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploy config for `npm run deploy` (Cloudflare Workers).
  // `vinext deploy` auto-generates this file only when it is absent, so it is
  // committed here to keep the worker name and bindings under version control.
  // Set CLOUDFLARE_ACCOUNT_ID in the environment, or add "account_id" below.
  "name": "careprint",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
